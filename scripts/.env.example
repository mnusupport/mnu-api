# Seed script settings. Variable NAMES only: never commit real values.
# The script reads mnu-api/.env first (the file your API already uses), so if
# DATABASE_URL is already set there you do not need this file at all.

# Local:  mongodb://localhost:27017/mnu_dev
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
DATABASE_URL=

# Optional overrides (defaults are already set to the Savaliya restaurant)
# SEED_RESTAURANT_ID=6ac87fea5f1bf179a201e3f1
# SEED_RESTAURANT_NAME=Savaliya
