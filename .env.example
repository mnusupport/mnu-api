# MnU API environment template. Variable NAMES only — never commit real values.
# Development: copy to backend/.env. Production: set these in the host's
# secret/environment manager, NOT in a file in the repository.

# ---- Runtime ----------------------------------------------------------
NODE_ENV=development            # production on the live host
PORT=3001                       # most hosts inject PORT themselves
# Number of reverse-proxy hops in front of the API (Render/Railway/Fly/Heroku/
# Nginx = 1). REQUIRED behind a proxy, otherwise per-IP rate limits see every
# user as one IP. Leave unset for local development.
TRUST_PROXY=

# ---- MongoDB ----------------------------------------------------------
# Production: a SEPARATE Atlas database name/user from development (e.g. mnu_prod).
# Production startup refuses a localhost URI.
DATABASE_URL=mongodb://localhost:27017/mnu_dev
MONGO_MAX_POOL_SIZE=10          # optional, default 10

# ---- Auth -------------------------------------------------------------
# >= 32 random chars (production refuses to start otherwise). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value in production than in development.
JWT_SECRET=

# ---- CORS -------------------------------------------------------------
# Comma-separated exact frontend origin(s). Production: https:// only, no "*".
CORS_ORIGINS=http://localhost:3000

# ---- App --------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata

# ---- Cloudinary (required in production) -------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Customer ordering -----------------------------------------------
# Customer checkout uses name + phone. Phone numbers are customer-provided
# and are NOT verified by SMS. No Twilio/OTP configuration is required.

# ---- Super Admin bootstrap (one-time, run from an operator machine) -----
# Used ONLY by `npm run db:bootstrap-super-admin`. Do NOT store these on the
# running API host after bootstrap. Password >= 12 chars.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=MnU Super Admin
# The bootstrap refuses to convert an EXISTING regular account (e.g. a restaurant owner) into the
# Super Admin. Use a dedicated email, or set SUPER_ADMIN_PROMOTE_EXISTING=true to do it deliberately.
# SUPER_ADMIN_PROMOTE_EXISTING=false
